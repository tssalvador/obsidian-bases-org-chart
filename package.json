{
  "name": "obsidian-bases-org-chart",
  "version": "1.0.0",
  "description": "Shows notes as an interactive org chart in Bases, linking each note to its manager through a property.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-build && esbuild 'test/*.test.ts' --bundle --platform=node --format=cjs --outdir=.test-build --out-extension:.js=.cjs --log-level=warning && node --test .test-build/*.test.cjs",
    "lint": "eslint src test eslint.config.mts",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "npm run check:versions && npm run build && npm run lint && npm test && npm audit --audit-level=high"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bases",
    "org-chart"
  ],
  "author": "Tiago Souza",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
